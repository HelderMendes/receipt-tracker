    "@schematichq/schematic-components": "^1.4.1",
    "@schematichq/schematic-react": "^1.2.5",
    "@schematichq/schematic-typescript-node": "^1.1.13",
    "@stripe/react-stripe-js": "^3.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.25.4",
    "inngest": "^3.40.1",
    "lucide-react": "^0.539.0",
    "next": "15.4.6",
    "postcss": "^8.5.6",
